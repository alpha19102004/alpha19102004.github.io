@inproceedings{phan2026sarag,
  abbr      = {ICTA},
  title     = {Section-Aware {RAG} with Evidence Reranking for Biomedical Question Answering},
  author    = {Phan, N. P. A. and Lam, T. X. T. and Le, A. D.},
  booktitle = {Proceedings of the 5th International Conference on Advances in Information and Communication Technology ({ICTA}), Lectures Notes in Networks and Systems, Springer},
  abstract  = {Most retrieval-augmented generation (RAG) systems retrieve biomedical text without considering document structure, treating all chunks equally even though evidence quality varies across sections. We propose Section-Aware RAG (SA-RAG), a framework that integrates section structure into the retrieval and reranking pipeline via two contributions: (1) a learnable section evidence prior trained with pairwise ranking loss to discover which sections most frequently contain supporting evidence, and (2) a relevance-gated reranking mechanism that applies section weighting only to high-scoring chunks. On a benchmark of 1,270 full-text diabetes articles from PubMed Central with 100 annotated question-answer pairs, SA-RAG raises Precision@3 from 0.4667 to 0.5333 and MRR@3 from 0.7000 to 0.7833 compared with a hybrid baseline. Downstream evaluation across five large language models shows that retrieval gains translate into better answers for GPT-4o and Claude Sonnet 4.6: Macro-F1 improves from 0.3076 to 0.4316 for GPT-4o and from 0.2585 to 0.3127 for Claude Sonnet 4.6, while smaller open-weight models benefit less. These results suggest that SA-RAG is a lightweight and effective strategy for biomedical question answering.},
  preview  = {sa-framework.png},
  year      = {2026},
  note      = {Accepted},
  selected  = {true}
}

@inproceedings{tuyet2025ghi,
  abbr      = {EEE-AM},
  title     = {Global Horizontal Irradiance Prediction Using Interpretable Tiny Machine Learning},
  author    = {Tuyet, H. V. T. and Nguyen, Q. D. and Phan, A. T. and Phan, N. P. A. and Tran, A. D. and Bui, V. C.},
  abstract  = {In distributed energy management systems, there is a critical need to provide low-cost, real-time, on-site Global Horizontal Irradiance (GHI) forecasting data. For this need, Tiny Machine Learning (TinyML) techniques on edge devices are a valuable and cost-effective solution. The paper investigates Tiny Transformer, a lightweight transformer version that performs better on time series data and is well-suited for edge devices. To evaluate the model's performance, two general tiny models, including RNN and ANN, are used. The collected data for model development query from an open weather data website, such as temperature, humidity, wind speed, sunshine duration, GHI, and hour of day. On Raspberry Pi and PCs, the results show that Tiny Transformer outperforms other models in terms of size, inference time, and accuracy. The highlight of this paper is the utilization of lookback with threshold error for model degradation analysis and the XAI method, SHAP (Shapley Additive Explanations) technique, to account for the influence of features on the model prediction. The paper shows the feasibility of implementing TinyML models and embedded AI on edge computing for energy prediction.},
  preview  = {ghi.png},
  booktitle = {Proceedings of the 2025 {IEEE} Asia Meeting on Environment and Electrical Engineering ({EEE-AM})},
  year      = {2025},
  publisher = {IEEE},
  doi       = {10.1109/EEE-AM66675.2025.11473413},
  url       = {https://doi.org/10.1109/EEE-AM66675.2025.11473413},
  selected  = {true}
}
